APP_MODE=integration
INTEGRATION_DRY_RUN=true
PRODUCTION_RECOVERY_ENABLED=false
EXTERNAL_RECOVERY_ENABLED=false
# Defaults resolve from the Factory checkout, not the shell working directory.
# Override only when your existing engines live elsewhere.
# LEGACY_TIKTOK_AUTO_ROOT=/absolute/path/to/TikTok_Auto
# LEGACY_TIKTOK_AUTO_PYTHON=/absolute/path/to/TikTok_Auto/.venv/bin/python
LEGACY_COLLECTOR_TIMEOUT_SECONDS=1200
LEGACY_PROCESS_TERMINATE_GRACE_SECONDS=5
# LEGACY_VIDEO_AUTO_ROOT=/absolute/path/to/video_auto
# LEGACY_VIDEO_AUTO_PYTHON=/absolute/path/to/video_auto/.venv/bin/python
LEGACY_VIDEO_TIMEOUT_SECONDS=3600
# QUALITY_PYTHON=/absolute/path/to/ComfyUI/.venv/bin/python
FRONTEND_ORIGIN=http://localhost:3000
# DATABASE_URL and STORAGE_ROOT default to this checkout's backend/factory.db and storage.
