APP_MODE=integration
INTEGRATION_DRY_RUN=true
PRODUCTION_RECOVERY_ENABLED=false
EXTERNAL_RECOVERY_ENABLED=false
FRONTEND_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=sqlite:///D:/AI_Video_Factory/backend/factory.windows-acceptance.db
STORAGE_ROOT=D:/AI_Video_Factory/storage/windows-acceptance
# Server-only Next variable; browser uses NEXT_PUBLIC_API_URL=/factory-api.
# The launcher sets these automatically for newly started services.
FACTORY_API_ORIGIN=http://127.0.0.1:8000
LEGACY_TIKTOK_AUTO_ROOT=D:/TikTok_Auto
LEGACY_TIKTOK_AUTO_PYTHON=D:/TikTok_Auto/.venv/Scripts/python.exe
LEGACY_VIDEO_AUTO_ROOT=D:/video_auto
LEGACY_VIDEO_AUTO_PYTHON=D:/video_auto/.venv/Scripts/python.exe
# QUALITY_PYTHON must be the verified Windows ComfyUI interpreter, not a Mac path.
# Use config/launcher.local.json for the verified database_path and storage_root.
# VIDEO_PUBLISH_CONFIG may point to a local safe Windows YAML after editing its paths.
# Secrets are never NEXT_PUBLIC variables and never committed.
